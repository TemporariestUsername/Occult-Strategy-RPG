<Project Sdk="Godot.NET.Sdk/4.6.0">

  <!--
    The Pale Communion — Godot 4 presentation layer. References Sim and reads its
    state / issues it commands; contains NO game rules (CLAUDE.md architecture law 2).
    `dotnet build` compiles this against GodotSharp (restored from NuGet); running and
    editing scenes needs the Godot 4 editor with .NET support.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PaleCommunion.Game</RootNamespace>
    <AssemblyName>ThePaleCommunion.Game</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <!--
      game/ is a subfolder of a larger monorepo. By default Godot.NET.Sdk compiles
      every *.cs under the project directory; if the repo (src/, tools/, …) is ever
      nested or copied beneath game/, that pulls the whole codebase into this assembly
      and the build fails with hundreds of errors. Restrict compilation to our own
      scripts so the presentation project only ever builds its own code.
    -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="scripts/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Sim/Sim.csproj" />
  </ItemGroup>

</Project>
